# Copiar a .env y cambiar los valores (el archivo .env NO se sube al repositorio).
# En el pipeline estas credenciales se generan aleatoriamente en cada despliegue.
MYSQL_ROOT_PASSWORD=cambiar-root
MYSQL_DATABASE=productos_db
MYSQL_USER=productos
MYSQL_PASSWORD=cambiar-password
APP_PORT=8080
# Imagen a desplegar (por defecto se construye localmente como ms-productos:local)
# APP_IMAGE=ghcr.io/usuario/repositorio:sha-abc1234
